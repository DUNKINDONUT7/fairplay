# Copy this file to .env and fill in your real values
# Never commit private secrets to version control

# ========================================
# BACKEND / DATABASE CONFIGURATION
# ========================================

# Supabase public client configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ========================================
# AI CONFIGURATION
# ========================================
# AI calls go through the `ai-proxy` Supabase Edge Function — the provider
# API key lives server-side only (Edge Function secrets), never in a
# VITE_* var, so it can never be extracted from the browser bundle. Set it
# with (pick one provider):
#   npx supabase secrets set GROQ_API_KEY=gsk_your_key AI_PROVIDER=groq
#   npx supabase secrets set OPENROUTER_API_KEY=sk-or-your_key AI_PROVIDER=openrouter
# then deploy: npx supabase functions deploy ai-proxy

# Model selection (client-side — just a model name, not a secret)
VITE_AI_CRITERIA_MODEL=openai/gpt-4o-mini
VITE_AI_CHATBOT_MODEL=openai/gpt-4o-mini

# ========================================
# APP CONFIGURATION
# ========================================

# Enable demo mode (uses seed users, no real auth)
# Set to false once Supabase tables are ready and you want app data to persist
VITE_DEMO_MODE=false

# Public deployed app URL used by Supabase email confirmation links.
# In production, set this to your real Vercel URL, for example:
# VITE_SITE_URL=https://fairplay-gray.vercel.app
VITE_SITE_URL=https://your-deployed-site.vercel.app

# Supabase Edge Function secrets for organizer approval emails:
# SITE_URL=https://your-deployed-site.vercel.app
# RESEND_API_KEY=re_your_resend_api_key
# APPROVAL_EMAIL_FROM=FairPlay <noreply@your-domain.com>

# ========================================
# NOTES
# ========================================
# 1. AI requests already go through the ai-proxy Edge Function — never add
#    a VITE_*_API_KEY var back, or the key ships in the public JS bundle.
# 2. The app will gracefully fall back to local generation if AI APIs are unavailable.
# 3. Demo mode allows testing without real API calls.
